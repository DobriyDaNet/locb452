local function MkBHLine(pos, obj)
    if not bhE then return end
    for _, d in ipairs(bhL) do if d.O == obj then return end end
    local l = Instance.new("Part")
    l.Name = "BHLine"; l.Size = Vector3.new(0.1, 0.1, 1)
    l.Color = Color3.fromRGB(255, 255, 255)
    l.Material = Enum.Material.Neon
    l.Anchored = true; l.CanCollide = false; l.CanTouch = false; l.CanQuery = false
    l.Transparency = 0.2; l.Parent = WS
    local at = Instance.new("Attachment", l)
    local bm = Instance.new("Beam", l)
    bm.Attachment0 = at; bm.Width0 = 0.3; bm.Width1 = 0.3
    bm.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    bm.Transparency = NumberSequence.new(0.1, 0.8)
    bm.Parent = l
    local c = RUN.RenderStepped:Connect(function()
        if not l or not l.Parent or not bhE then
            if c then c:Disconnect() end; return
        end
        local ch = LP.Character
        if not ch then return end
        local r = ch:FindFirstChild("HumanoidRootPart")
        if not r then return end
        local sp, ep = r.Position, pos
        l.CFrame = CFrame.new((sp + ep) / 2, ep)
        l.Size = Vector3.new(0.1, 0.1, (sp - ep).Magnitude)
    end)
    table.insert(bhL, { L = l, C = c, O = obj })
end

local function MkBHCopy(o, pn, dn)
    local pos
    local tr = 18
    if o:IsA("BasePart") then pos = o.Position
    elseif o:IsA("Model") and o.PrimaryPart then pos = o.PrimaryPart.Position end
    if not pos then return end
    local cp = Instance.new("Part")
    cp.Name = "BHCopy"; cp.Shape = Enum.PartType.Ball
    cp.Size = Vector3.new(0.1, 0.1, 0.1); cp.CFrame = CFrame.new(pos)
    cp.Anchored = true; cp.CanCollide = false; cp.CanTouch = false; cp.CanQuery = false
    cp.Transparency = 0.5; cp.Color = Color3.fromRGB(0, 0, 0)
    cp.Material = Enum.Material.SmoothPlastic; cp.Parent = WS
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(0, 0, 0); hl.FillTransparency = 1
    hl.OutlineColor = Color3.fromRGB(255, 255, 255); hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = cp; hl.Parent = cp
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 180, 0, 36)
    bb.StudsOffset = Vector3.new(0, tr + 3, 0)
    bb.AlwaysOnTop = true; bb.Parent = cp
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(1, 0, 1, 0); lb.BackgroundTransparency = 1
    lb.Text = dn .. " (" .. pn .. ")"
    lb.TextColor3 = Color3.fromRGB(255, 255, 255)
    lb.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lb.TextStrokeTransparency = 0
    lb.Font = Enum.Font.SourceSansBold; lb.TextSize = 17; lb.TextWrapped = true
    lb.Parent = bb
    local dd = { C = cp, O = o, P = pos, B = bb, TR = tr, BS = 17 }
    table.insert(bhC, dd)
    task.spawn(function()
        local st = os.clock()
        while os.clock() - st < 0.83 do
            if not cp or not cp.Parent then return end
            local t = (os.clock() - st) / 0.83
            local cr = tr * t
            cp.Size = Vector3.new(cr * 2, cr * 2, cr * 2)
            lb.TextSize = math.max(1, dd.BS * t)
            task.wait()
        end
        local hs = os.clock()
        while os.clock() - hs < 2 do
            if not cp or not cp.Parent then return end
            task.wait()
        end
        local fs = os.clock()
        while os.clock() - fs < 4 do
            if not cp or not cp.Parent then return end
            local t = (os.clock() - fs) / 4
            local cr = tr * (1 - t)
            cp.Size = Vector3.new(cr * 2, cr * 2, cr * 2)
            lb.TextSize = math.max(1, dd.BS * (1 - t))
            task.wait()
        end
        if cp and cp.Parent then cp:Destroy() end
        if bb and bb.Parent then bb:Destroy() end
        for i, x in ipairs(bhC) do if x == dd then table.remove(bhC, i); break end end
    end)
end

