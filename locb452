local function RemoveAK(tn)
    pD[tn] = nil
    local d = akP[tn]
    if d then
        if d.BP and d.BP.Parent then d.BP:Destroy() end
        if d.BG and d.BG.Parent then d.BG:Destroy() end
        if d.Plate and d.Plate.Parent then pcall(function() d.DT:FireServer(d.Plate) end) end
        akP[tn] = nil
    end
    akA[tn] = nil
end

local function CreateAK(tp, tn)
    if akP[tn] and akP[tn].Plate and akP[tn].Plate.Parent then return end
    local spT = RS:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local dT = RS:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    local sNO = RS:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
    local gE = RS:WaitForChild("GrabEvents")
    local ch = LP.Character
    local rp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not rp then return end
    spT:InvokeServer(akItem, rp.CFrame * CFrame.new(0, 5, 0), Vector3.zero)
    task.wait(0.3)
    local tf = WS:FindFirstChild(LP.Name .. "SpawnedInToys")
    local pl = nil
    if tf then
        for _, c in pairs(tf:GetChildren()) do
            if c.Name == akItem and not c:GetAttribute("AntiKickTarget") then pl = c; break end
        end
    end
    if not pl then return end
    pl:SetAttribute("AntiKickTarget", tn)
    for _, pt in pairs(pl:GetDescendants()) do
        if pt:IsA("BasePart") then
            pt.CanCollide = false; pt.CanQuery = false; pt.CanTouch = false
            pt.Transparency = 0.5
            pt.AssemblyLinearVelocity = Vector3.zero
            pt.AssemblyAngularVelocity = Vector3.zero
            if not pt:FindFirstChild("Highlight") then
                local h = Instance.new("Highlight", pt)
                h.FillColor = Color3.fromRGB(255, 105, 180); h.FillTransparency = 0.5
                h.OutlineColor = Color3.fromRGB(255, 20, 147); h.OutlineTransparency = 0
            end
        end
    end
    local sPt = pl:FindFirstChild("SoundPart") or pl:FindFirstChildWhichIsA("BasePart")
    if not sPt then pcall(function() dT:FireServer(pl) end); return end
    pcall(function()
        if akItem == "ToolPickaxe" then
            sPt.CFrame = sPt.CFrame * CFrame.Angles(math.rad(90), math.rad(325), 0)
        else
            sPt.CFrame = sPt.CFrame * CFrame.Angles(math.rad(90), 0, 0)
        end
    end)
    task.wait(0.05)
    local bp = Instance.new("BodyPosition")
    bp.D = 200; bp.P = 1000
    bp.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bp.Parent = sPt
    local bg = Instance.new("BodyGyro")
    bg.D = 200; bg.P = 1000
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.Parent = sPt
    akP[tn] = { Plate = pl, BP = bp, BG = bg, SoundPart = sPt, DT = dT, SNO = sNO, GE = gE }
    local lu, lc = 0, LP.Character
    local con
    con = RUN.RenderStepped:Connect(function()
        local d = akP[tn]
        if not d or not d.Plate or not d.Plate.Parent or not d.BP or not d.BP.Parent then
            if con then con:Disconnect() end; return
        end
        local p = P:FindFirstChild(tn == "Self" and LP.Name or tn)
        if not p or not p.Parent then return end
        if not akA[tn] then return end
        if lc ~= LP.Character then
            lc = LP.Character
            akP[tn] = nil; akA[tn] = false
            task.wait(0.3)
            if akA[tn] == false then akA[tn] = true; CreateAK(p, tn) end
            if con then con:Disconnect() end; return
        end
        if d.Plate and d.Plate.Parent then
            for _, pt in pairs(d.Plate:GetDescendants()) do
                if pt:IsA("BasePart") then
                    pt.CanCollide = false; pt.CanQuery = false; pt.CanTouch = false
                    pt.AssemblyLinearVelocity = Vector3.zero
                    pt.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
        local tch = p.Character
        local tr = tch and tch:FindFirstChild("HumanoidRootPart")
        local det = pD[tn]
        if det and not det.Parent then pD[tn] = nil; det = nil end
        if not det then
            local cd = math.huge
            for _, o in ipairs(WS:GetDescendants()) do
                if IsPCLD(o) and tr then
                    local ds = (o.Position - tr.Position).Magnitude
                    if ds < cd then cd = ds; det = o end
                end
            end
            if det then pD[tn] = det end
        end
        if det and det.Parent then
            local pc = det
            d.BP.Position = pc.Position
            if d.BG and d.BG.Parent then
                if akItem == "ToolPickaxe" then
                    d.BG.CFrame = pc.CFrame * CFrame.Angles(math.rad(90), math.rad(325), 0)
                else
                    d.BG.CFrame = pc.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                end
            end
            if d.SoundPart and d.SoundPart.Parent then
                if akItem == "ToolPickaxe" then
                    d.SoundPart.CFrame = pc.CFrame * CFrame.Angles(math.rad(90), math.rad(325), 0)
                else
                    d.SoundPart.CFrame = pc.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                end
                d.SoundPart.CanCollide = false; d.SoundPart.CanQuery = false; d.SoundPart.CanTouch = false
                d.SoundPart.AssemblyLinearVelocity = Vector3.zero
                d.SoundPart.AssemblyAngularVelocity = Vector3.zero
            end
            if tick() - lu >= 0.1 and d.GE:FindFirstChild("CreateGrabLine") then
                lu = tick()
                pcall(function()
                    d.SNO:FireServer(d.SoundPart, d.SoundPart.CFrame)
                    d.GE.CreateGrabLine:FireServer(d.SoundPart, Vector3.zero, pc.Position, true)
                end)
            end
        else
            local tp = tr and tr.Position
            if tp then
                d.BP.Position = tp
                if d.SoundPart and d.SoundPart.Parent then
                    if akItem == "ToolPickaxe" then
                        d.SoundPart.CFrame = CFrame.new(tp) * CFrame.Angles(math.rad(90), math.rad(325), 0)
                    else
                        d.SoundPart.CFrame = CFrame.new(tp) * CFrame.Angles(math.rad(90), 0, 0)
                    end
                    d.SoundPart.CanCollide = false; d.SoundPart.CanQuery = false; d.SoundPart.CanTouch = false
                    d.SoundPart.AssemblyLinearVelocity = Vector3.zero
                    d.SoundPart.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end)
    task.spawn(function()
        while akA[tn] do task.wait(1) end
        if con then con:Disconnect() end
        pD[tn] = nil
        local d = akP[tn]
        if d then
            if d.BP and d.BP.Parent then d.BP:Destroy() end
            if d.BG and d.BG.Parent then d.BG:Destroy() end
            if d.Plate and d.Plate.Parent then pcall(function() d.DT:FireServer(d.Plate) end) end
            akP[tn] = nil
        end
        akA[tn] = nil
    end)
end

local function RecreateAK(tn)
