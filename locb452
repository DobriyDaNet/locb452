local pcTr, pcBr = 0.5, 1
local pcObj, pcAct, pcThr, pcTrc = {}, false, nil, nil

local function PcCol() return Color3.new(0.6 * pcBr, 0.6 * pcBr, 0.6 * pcBr) end

local function ClosestPCLD(pos)
    local cp, cd = nil, math.huge
    for _, p in ipairs(P:GetPlayers()) do
        local ch = p.Character
        if ch then
            local r = ch:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (pos - r.Position).Magnitude
                if d < cd then cd = d; cp = p end
            end
        end
    end
    return cp or LP
end

local function KillPCTrc()
    if pcTrc then
        if pcTrc.B and pcTrc.B.Parent then pcTrc.B:Destroy() end
        if pcTrc.BP and pcTrc.BP.Parent then pcTrc.BP:Destroy() end
        if pcTrc.C then pcTrc.C:Disconnect() end
        pcTrc = nil
    end
end

local function MakePC(d, o)
