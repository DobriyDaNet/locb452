local BB_OFF = CFrame.new(0, 1.0, 1.0) * CFrame.Angles(0, math.rad(180), 0)

local function RemoveBB()
    if bbCur and bbCur.Parent then pcall(function() RS.MenuToys.DestroyToy:FireServer(bbCur) end) end
