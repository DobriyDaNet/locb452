exG:AddToggle("AIL", {
    Text = "Anti Input Lag",
    Default = false,
    Callback = function(on)
        _G.AIL = on
        if not on then return end
        task.spawn(function()
            local sR = RS:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
            local lt = 0
            while _G.AIL do
                local ch = LP.Character
                if not ch then task.wait(0.001); continue end
                local rp = ch:FindFirstChild("HumanoidRootPart")
                if not rp then task.wait(0.001); continue end
                local tf = WS:FindFirstChild(LP.Name .. "SpawnedInToys")
                local ty = tf and tf:FindFirstChild(selToy)
                if not ty then
                    pcall(function() sR:InvokeServer(selToy, rp.CFrame * CFrame.new(0, 5, 0), Vector3.zero) end)
                    task.wait(0.1); continue
                end
                if ty and ty:FindFirstChild("HoldPart") then
                    local dl = math.max(0.001, 1 - (lagSpd / 100))
                    if tick() - lt >= dl then
                        for i = 1, 5000 do
                            pcall(function()
                                ty.HoldPart.HoldItemRemoteFunction:InvokeServer(ty, ch)
