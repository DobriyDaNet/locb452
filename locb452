local skB, skS = nil, 0.5

local function ApplySky()
    local L = game:GetService("Lighting")
    if not skB then
        skB = { CT = L.ClockTime, BR = L.Brightness, EC = L.ExposureCompensation, AM = L.Ambient, OA = L.OutdoorAmbient, GS = L.GlobalShadows }
    end
    L:ClearAllChildren()
    local br = 0.582 + (29.11 - 0.582) * skS
    L.ClockTime = 17.8; L.Brightness = br; L.ExposureCompensation = 0.582
    L.Ambient = Color3.fromRGB(170, 120, 90); L.OutdoorAmbient = Color3.fromRGB(255, 190, 140)
    L.GlobalShadows = false
    local s = Instance.new("Sky")
    s.SunAngularSize = 12; s.MoonAngularSize = 12; s.StarCount = 3000; s.Parent = L
    local a = Instance.new("Atmosphere")
    a.Density = 0.35; a.Offset = 0.1
    a.Color = Color3.fromRGB(255, 200, 150); a.Decay = Color3.fromRGB(255, 170, 120)
    a.Glare = 0.4; a.Haze = 0.6; a.Parent = L
    local c = Instance.new("ColorCorrectionEffect")
    c.Brightness = br * 0.05; c.Contrast = 0.15; c.Saturation = 0.00928
    c.TintColor = Color3.fromRGB(255, 190, 150); c.Parent = L
    local b = Instance.new("BloomEffect")
    b.Intensity = 0.9; b.Size = 40; b.Threshold = 0.85; b.Parent = L
    local sr = Instance.new("SunRaysEffect")
    sr.Intensity = 0.112; sr.Spread = 0.6; sr.Parent = L
end

local function UpdateSky()
    local L = game:GetService("Lighting")
    if not L:FindFirstChildOfClass("Sky") then return end
    local br = 0.582 + (29.11 - 0.582) * skS
    L.Brightness = br
    local c = L:FindFirstChildOfClass("ColorCorrectionEffect")
    if c then c.Brightness = br * 0.05 end
end

local function RestoreSky()
    local L = game:GetService("Lighting")
    L:ClearAllChildren()
    if skB then
        L.ClockTime = skB.CT; L.Brightness = skB.BR; L.ExposureCompensation = skB.EC
        L.Ambient = skB.AM; L.OutdoorAmbient = skB.OA; L.GlobalShadows = skB.GS
    end
end

