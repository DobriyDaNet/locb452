local function Freeze(ch)
    local rp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not rp then return end
    sCF = rp.CFrame
    sPos = rp.Position
    isFz = true
    if not rp:FindFirstChild("FreezeJoint") then
        local al = Instance.new("AlignPosition")
        local at = Instance.new("Attachment", rp)
        al.Name = "FreezeJoint"
        al.Mode = Enum.PositionAlignmentMode.OneAttachment
        al.MaxForce = 1e6; al.MaxVelocity = 0; al.Responsiveness = 200
        al.Attachment0 = at; al.Position = sPos
        al.Parent = rp
    end
    if fzC then fzC:Disconnect() end
    fzC = RUN.Heartbeat:Connect(function()
        if isFz and rp and rp.Parent then
            rp.AssemblyLinearVelocity = Vector3.zero
            rp.AssemblyAngularVelocity = Vector3.zero
            rp.CFrame = sCF
        end
    end)
end

