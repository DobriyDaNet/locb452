local CA = { F = {}, BG = nil, BH = nil, BHS = nil }

local function LoadAsset(url, pref, ext)
    if type(url) ~= "string" or url == "" then return nil end
    if not (writefile and getcustomasset) then
        if url:match("^rbxassetid://") or url:match("^%d+$") then
            return "rbxassetid://" .. url:gsub("%D", "")
        end
        return url
    end
    local g = game:GetService("HttpService"):GenerateGUID(false):gsub("%-", "")
    local fn = "c_" .. (pref or "a") .. "_" .. g .. (ext or "")
    local ok, r = pcall(function() return game:HttpGet(url, true) end)
    if not ok or type(r) ~= "string" or r == "" then return nil end
    if not pcall(writefile, fn, r) then return nil end
    CA.F[fn] = fn
    local ok2, a = pcall(getcustomasset, fn)
    if not ok2 or not a then return nil end
    return a
end

local function ApplyBG(a) pcall(function() Library:SetBackgroundImage(a) end) end

local function ApplyBH(a)
    if not a or a == "" then return end
    for _, o in ipairs(WS:GetDescendants()) do
        if o.Name == "BlackHoleKick" or o.Name == "BlackHoleDetected" then
            if o:IsA("BasePart") then o.Transparency = 1 end
            local bb = o:FindFirstChild("BillboardGui", true)
            if bb then
                local l = bb:FindFirstChild("Large", true)
                if l and l:IsA("ImageLabel") then
                    l.Image = a; l.ImageTransparency = 0
                    l.BackgroundTransparency = 1; l.Visible = true
                end
            end
            for _, c in ipairs(o:GetDescendants()) do
                if c:IsA("Highlight") then c.FillTransparency = 1; c.OutlineTransparency = 1 end
            end
        end
    end
end

local function ApplyBHS(a)
    if not a or a == "" then return end
    for _, o in ipairs(WS:GetDescendants()) do
        if o.Name == "BlackHoleKick" or o.Name == "BlackHoleDetected" then
            local d = o:FindFirstChild("Drone", true)
            if d and d:IsA("Sound") then d.SoundId = a end
        end
    end
end

