local function SitTrain()
    if gcR then return end
    gcR = true
    local ch = LP.Character
    local hm = ch and ch:FindFirstChild("Humanoid")
    local rp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not ch or not hm or not rp then gcR = false; return end
    local oc = ch:GetPivot()
    local tr = WS.Map.AlwaysHereTweenedObjects and WS.Map.AlwaysHereTweenedObjects:FindFirstChild("Train")
    local st = nil
    if tr then
        for _, c in pairs(tr:GetDescendants()) do
            if c:IsA("Seat") and c.Occupant == nil and c ~= lsD.LastSeat then
                lsD.LastSeat = c; st = c; break
            end
        end
    end
    if not st then gcR = false; return end
    st:Sit(hm)
    task.spawn(function()
        local et = tick() + 0.5
        while tick() < et and task.wait() do
            pcall(function() RS.CharacterEvents.RagdollRemote:FireServer(rp, 0) end)
        end
    end)
    task.wait()
    while not hm.SeatPart do task.wait() end
    hm.Sit = false
    task.wait()
    for i = 1, 3 do ch:PivotTo(oc) end
    gcR = false
end

local function MonGC()
    if gcC then gcC:Disconnect(); gcC = nil end
    gcC = RUN.Heartbeat:Connect(function()
        if not gcA then return end
        local ch = LP.Character
        if not ch then return end
        local hm = ch:FindFirstChild("Humanoid")
        if not hm then return end
        local rp = ch:FindFirstChild("HumanoidRootPart")
        if not rp then return end
        local hd = ch:FindFirstChild("Head")
        local gb = hd and hd:FindFirstChild("PartOwner")
        local phy = hm:GetState() == Enum.HumanoidStateType.Physics
        local ff = hm:GetState() == Enum.HumanoidStateType.Freefall
        local dd = hm.Health <= 0
        if gb or phy or ff or dd then
            pcall(function() RS.CharacterEvents.RagdollRemote:FireServer(rp, 0) end)
            task.wait(0.5)
            if gcA then SitTrain() end
        end
    end)
end

