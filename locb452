local function MakePCTrc()
    KillPCTrc()
    local mc = LP.Character
    if not mc then return end
    local mr = mc:FindFirstChild("HumanoidRootPart") or mc:FindFirstChild("Head")
    if not mr then return end
    local best, bd = nil, math.huge
    for _, dt in ipairs(pcObj) do
        if dt.P and dt.P.Parent and dt.ON == LP.Name then
            local dd = (dt.P.Position - mr.Position).Magnitude
            if dd < bd then bd = dd; best = dt.P end
        end
    end
    if not best then return end
    local bP2 = Instance.new("Part")
    bP2.Name = "PCLD_TracerPart"
    bP2.Size = Vector3.new(0.1, 0.1, 1); bP2.Transparency = 1
    bP2.Anchored = true; bP2.CanCollide = false; bP2.CanQuery = false; bP2.CanTouch = false
    bP2.Parent = WS
    local a0 = Instance.new("Attachment", bP2); a0.Name = "FromChar"
    local a1 = Instance.new("Attachment", best); a1.Name = "ToPCLD"
    local bm = Instance.new("Beam")
    bm.Attachment0 = a0; bm.Attachment1 = a1
    bm.Width0 = 0.065625; bm.Width1 = 0.065625
    bm.Color = ColorSequence.new(Color3.new(1, 1, 1))
    bm.Transparency = NumberSequence.new(0, 0)
    bm.FaceCamera = true; bm.Segments = 1; bm.Parent = bP2
    local c = RUN.RenderStepped:Connect(function()
        if not bm or not bm.Parent then return end
        if not best or not best.Parent then KillPCTrc(); return end
        local ch = LP.Character
        if not ch then return end
        local r = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
        if not r then return end
        a0.WorldPosition = r.Position
        a1.WorldPosition = best.Position
    end)
    pcTrc = { B = bm, BP = bP2, A0 = a0, A1 = a1, T = best, C = c }
end

