        if dt.BB and dt.BB.Parent then dt.BB:Destroy() end
        if dt.P and dt.P.Parent then dt.P:Destroy() end
        if dt.C then dt.C:Disconnect() end
    end
    pcObj = {}
    KillPCTrc()
end

local function MakePCA()
    ClearPC()
    local pp = {}
    for _, o in ipairs(gP) do
        if o and o.Parent and IsPCLD(o) then table.insert(pp, o) end
    end
    if #pp == 0 then return end
    for _, d in ipairs(pp) do
        local o = ClosestPCLD(d.Position)
        MakePC(d, o)
    end
    MakePCTrc()
    if pcThr then task.cancel(pcThr) end
    pcThr = task.spawn(function()
        while pcAct do
            task.wait(3)
            if not pcAct then break end
            local nr = false
            for _, dt in ipairs(pcObj) do
                if not dt.R or not dt.R.Parent then continue end
                local no = ClosestPCLD(dt.R.Position)
                if no and no.Name ~= dt.ON then
                    dt.ON = no.Name; dt.OD = no.DisplayName
                    if dt.LB and dt.LB.Parent then
                        dt.LB.Text = "PCLD | " .. no.DisplayName .. "\n(" .. no.Name .. ")"
                    end
                    nr = true
                end
            end
            if nr or (pcTrc and (not pcTrc.T or not pcTrc.T.Parent)) then MakePCTrc() end
            local ow = {}
            for _, dt in ipairs(pcObj) do if dt.ON then ow[dt.ON] = true end end
            local mp = {}
            for _, p in ipairs(P:GetPlayers()) do
                if not ow[p.Name] then table.insert(mp, p) end
            end
            if #mp > 0 then
                local ud = {}
                for _, dt in ipairs(pcObj) do if dt.R then ud[dt.R] = true end end
                local fd = {}
                for _, o in ipairs(gP) do
                    if o and o.Parent and IsPCLD(o) and not ud[o] then table.insert(fd, o) end
                end
                local ad = false
                for _, p in ipairs(mp) do
                    if #fd == 0 then break end
                    local d = table.remove(fd, 1)
                    if d and d.Parent then MakePC(d, p); ad = true end
                end
                if ad then MakePCTrc() end
            end
        end
    end)
end

