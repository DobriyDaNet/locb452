local function GetBBMain(bb)
    if not bb then return nil end
    if bb:IsA("BasePart") then return bb end
    local sp = bb:FindFirstChild("SoundPart")
    if sp and sp:IsA("BasePart") then return sp end
    if bb.PrimaryPart then return bb.PrimaryPart end
    return bb:FindFirstChildWhichIsA("BasePart")
end

local function GetBBOwn(bb)
    if not bb then return nil end
    local p = bb:FindFirstChild("SoundPart") or bb:FindFirstChildWhichIsA("BasePart")
    if not p then return nil end
    local o = p:FindFirstChild("PartOwner")
    if o and o:IsA("ObjectValue") then return o.Value end
    return nil
end

local function WeldBB(bb)
    if not bb or not bb.Parent then return end
    local ch = LP.Character
    if not ch then return end
    local bP = ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
    if not bP then return end
    local mP = GetBBMain(bb)
    if not mP then return end

    for _, o in ipairs(bP:GetChildren()) do
        if o.Name == "BoomboxWeld" or o.Name == "BoomboxPartWeld" then o:Destroy() end
    end
    for _, pt in ipairs(bb:GetDescendants()) do
        if pt:IsA("BasePart") then
            for _, o in ipairs(pt:GetChildren()) do
                if o.Name == "BoomboxWeld" or o.Name == "BoomboxPartWeld" then o:Destroy() end
            end
        end
    end

    for _, pt in pairs(bb:GetDescendants()) do
        if pt:IsA("BasePart") then
            pt.CanCollide = false; pt.CanQuery = false; pt.CanTouch = false
            pt.Massless = true; pt.Anchored = false
            pt.AssemblyLinearVelocity = Vector3.zero
            pt.AssemblyAngularVelocity = Vector3.zero
            pcall(function() pt.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0) end)
            for _, c in ipairs(pt:GetChildren()) do
                if c.Name ~= "BoomboxWeld" and c.Name ~= "BoomboxPartWeld" then
                    if c:IsA("BodyPosition") or c:IsA("BodyGyro") or c:IsA("BodyVelocity") or c:IsA("BodyAngularVelocity") or c:IsA("BodyForce") or c:IsA("BodyThrust") or c:IsA("VectorForce") or c:IsA("Torque") or c:IsA("LinearVelocity") or c:IsA("AngularVelocity") or c:IsA("AlignPosition") or c:IsA("AlignOrientation") or c:IsA("AlignConstraint") or c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("Motor6D") or c:IsA("Snap") then
                        c:Destroy()
                    end
                end
            end
        end
    end

    mP.CFrame = bP.CFrame * BB_OFF
    mP.AssemblyLinearVelocity = Vector3.zero
    mP.AssemblyAngularVelocity = Vector3.zero
    task.wait()

    if bb:IsA("Model") then
        pcall(function() bb:PivotTo(bP.CFrame * BB_OFF) end)
        task.wait()
    end

    for _, pt in pairs(bb:GetDescendants()) do
        if pt:IsA("BasePart") then
            if pt == mP then
                local w = Instance.new("Weld")
                w.Name = "BoomboxWeld"
                w.Part0 = bP; w.Part1 = mP
                w.C0 = BB_OFF; w.C1 = CFrame.new(0, 0, 0)
                w.Parent = bP
            else
                local w = Instance.new("Weld")
                w.Name = "BoomboxPartWeld"
                w.Part0 = mP; w.Part1 = pt
                w.C0 = mP.CFrame:ToObjectSpace(pt.CFrame)
                w.C1 = CFrame.new(0, 0, 0)
                w.Parent = mP
            end
        end
    end
end

